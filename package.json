{
  "name": "competitor-pricing-intelligence-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Automatically discover, monitor, and analyze competitor pricing using You.com, PostgreSQL, and xAI.",
  "scripts": {
    "install:all": "npm install && npm install --prefix client",
    "server": "node server/index.js",
    "db:migrate": "node scripts/migrate.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build:client",
    "build:client": "npm run build --prefix client",
    "lint": "eslint . --max-warnings=0 && npm run lint --prefix client",
    "test": "node --test",
    "check": "npm run test && npm run lint && npm run build:client",
    "start:server": "node server/index.js",
    "start": "node server/index.js",
    "start:all": "concurrently -n server,client -c blue,magenta \"node server/index.js\" \"npm run start --prefix client\""
  },
  "type": "module",
  "dependencies": {
    "cors": "^2.8.5",
    "diff": "^7.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "openai": "^6.45.0",
    "pg": "^8.23.0",
    "resend": "^6.16.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@electric-sql/pglite-socket": "^0.2.8",
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "globals": "^17.7.0"
  }
}
