# Public frontend URL for the Express API. Leave empty when using same-origin
# rewrites; use http://localhost:4000 for local development.
NEXT_PUBLIC_API_BASE=http://localhost:4000

# Insforge browser client configuration. The anon key is public by design;
# authorization must be enforced by backend/database policies.
NEXT_PUBLIC_INSFORGE_BASE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Server-side values used by Next.js route handlers for the feature-request board.
INSFORGE_BASE_URL=
INSFORGE_ANON_KEY=

# At least 32 characters; signs anonymous ownership cookies for feature requests.
FEATURE_REQUEST_SIGNING_SECRET=

# Public site URL used for OAuth redirect URIs (no trailing slash).
APP_URL=http://localhost:3000

# First-party Google/GitHub OAuth (browser never visits InsForge).
# Google Cloud Console → OAuth client → Authorized redirect URI:
#   {APP_URL}/api/auth/oauth/callback/google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GitHub → Developer settings → OAuth Apps → Authorization callback URL:
#   {APP_URL}/api/auth/oauth/callback/github
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Optional dedicated secret for OAuth state/session cookies (falls back to FEATURE_REQUEST_SIGNING_SECRET).
OAUTH_STATE_SECRET=
