# ---- Local development: you do not need a client/.env.local ----
# next.config.mjs reads the repo-root .env. Anything set here or in the hosting
# environment wins.

# Public frontend URL for the Express API. Leave empty when using same-origin
# rewrites; defaults to http://localhost:4000 outside production.
NEXT_PUBLIC_API_BASE=

# Optional writable path for the JSON feature-request board.
FEATURE_REQUESTS_JSON_PATH=

# Public site URL.
APP_URL=http://localhost:3000
