# ---- Competitor Pricing Intelligence Agent ----
# Copy this file to ".env" and fill in your keys.
# Keys can also be set directly in the Settings page of the app.

# You.com API key — get $100 free credits at https://you.com/platform
# Used for competitor Discovery (Research API) and pricing page Fetching (Contents API).
YOUCOM_API_KEY=

# xAI (Grok) API key — https://console.x.ai
# Used to extract structured competitors and analyze pricing diffs.
XAI_API_KEY=

# Grok model used for analysis (default shown). OpenAI-compatible endpoint.
XAI_MODEL=grok-4

# Override the xAI base URL if needed (defaults to the public endpoint).
XAI_BASE_URL=https://api.x.ai/v1

# ---- Insforge (backend database) ----
# Your Insforge project URL and anon key — get these from your Insforge dashboard.
INSFORGE_BASE_URL=https://tpq6mvqe.us-east.insforge.app
INSFORGE_ANON_KEY=anon_b6023a1adec5472cfe335ee7fec1139a85bd05a43a2f0513e2eba963c4a71d1f

# Server port (the Next.js client proxies /api to this in dev).
PORT=4000

# Set to "false" to disable the 24h scheduled auto-refresh.
AUTO_REFRESH_ENABLED=true
