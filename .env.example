# ---- Competitor Intelligence Agent ----
# Copy this file to ".env" and fill in your keys.
# API keys can also be set directly in the Settings page of the app.

# You.com API key — get $100 free credits at https://you.com/platform
# Used for competitor Discovery (Research API), pricing Fetching (Contents API),
# review sentiment, and deep market intelligence (Finance Research API).
YOUCOM_API_KEY=

# Default region/currency for You.com pricing research (App Store / Play / web).
PRICING_REGION=US
PRICING_CURRENCY=USD

# ---- Postgres (application database) ----
# Standard PostgreSQL connection string.
# Apply the schema with: npm run db:migrate
#   local example: postgresql://postgres@localhost:5432/cia?sslmode=disable
DATABASE_URL=
# Optional: pin account-free deployments to one existing shared workspace.
DEFAULT_WORKSPACE_ID=

# Optional writable path for the JSON feature-request board.
# Defaults to client/data/feature-requests.json.
FEATURE_REQUESTS_JSON_PATH=

# Public report links expire automatically after this many days (1–365).
SHARED_REPORT_TTL_DAYS=30

# ---- Web Push notifications (VAPID) ----
# Generate a keypair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Weekly digest email (Resend) ----
# API key from https://resend.com (free tier ~3k emails/mo). Leave blank to
# disable digest emails — the toggle/UI still work, emails are just skipped.
RESEND_API_KEY=
# Sender address on a domain verified in Resend (Domains → joinmira.ai).
DIGEST_FROM_EMAIL=Mira <noreply@joinmira.ai>

# ---- Inbound email → SMS alerts (Next.js on Vercel) ----
# Resend webhook signing secret (whsec_…) from Resend → Webhooks → email.received.
# Endpoint: https://www.joinmira.ai/api/webhooks/resend
RESEND_WEBHOOK_SECRET=
# Comma-separated inbox addresses that should trigger an SMS (defaults below).
SMS_ALERT_TO_EMAILS=sam@joinmira.ai,support@joinmira.ai
# Your phone in E.164 (e.g. +15551234567).
SMS_ALERT_PHONE=
# Twilio REST credentials (https://console.twilio.com) — SMS From must be SMS-capable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# In-app Help & feedback form delivery (comma-separated ok).
# Prefer Zendesk so tickets land in the AI agent / agent workspace.
SUPPORT_TO_EMAIL=support@miraai.zendesk.com
# Optional extra inbox(es) for support copies (e.g. sam@joinmira.ai).
SUPPORT_NOTIFY_EMAIL=

# Zendesk Messaging Web Widget (AI agent). When set, replaces the Help FAB on app pages.
# Key: Zendesk Admin → Channels → Messaging → Web Widget → Installation.
NEXT_PUBLIC_ZENDESK_KEY=

# Public URL of the frontend — used for links inside digest emails
# (set to your deployed frontend URL in production).
APP_URL=http://localhost:3000

# Server port (the Next.js client proxies /api to this in dev).
PORT=4000

# Set to "false" to disable the 24h scheduled auto-refresh.
AUTO_REFRESH_ENABLED=true

# ---- Tavily (independent fact-check search) ----
# Free key from https://tavily.com — verifies the market model's claims via a pipeline
# independent of You.com. If unset, the fact-check falls back to You.com (labeled as such).
TAVILY_API_KEY=
