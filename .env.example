# ---- Competitor Intelligence Agent ----
# Copy this file to ".env" and fill in your keys.
# API keys can also be set directly in the Settings page of the app.

# You.com API key — get $100 free credits at https://you.com/platform
# Used for competitor Discovery (Research API), pricing Fetching (Contents API),
# review sentiment, and deep market intelligence (Finance Research API).
YOUCOM_API_KEY=

# xAI (Grok) API key — https://console.x.ai
# Used to extract structured competitors and analyze pricing/feature/value diffs.
XAI_API_KEY=

# Grok model used for analysis (default shown). OpenAI-compatible endpoint.
XAI_MODEL=grok-4

# Override the xAI base URL if needed (defaults to the public endpoint).
XAI_BASE_URL=https://api.x.ai/v1

# ---- Insforge (backend database + auth) ----
# Your Insforge project URL and anon key — get these from your Insforge dashboard.
INSFORGE_BASE_URL=
INSFORGE_ANON_KEY=

# ---- Web Push notifications (VAPID) ----
# Generate a keypair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Weekly digest email (Resend) ----
# API key from https://resend.com (free tier ~3k emails/mo). Leave blank to
# disable digest emails — the toggle/UI still work, emails are just skipped.
RESEND_API_KEY=
# Sender address. Must be on a domain you've verified in Resend. Until you verify
# a domain, Resend's onboarding@resend.dev only delivers to your own account email.
DIGEST_FROM_EMAIL=Competitor Intelligence Agent <onboarding@resend.dev>

# Public URL of the frontend — used for links inside digest emails
# (set to your deployed Vercel/Render URL in production).
APP_URL=http://localhost:3000

# Server port (the Next.js client proxies /api to this in dev).
PORT=4000

# Set to "false" to disable the 24h scheduled auto-refresh.
AUTO_REFRESH_ENABLED=true
