# ---- Competitor Intelligence Agent ----
# Copy this file to ".env" and fill in your keys.
# API keys can also be set directly in the Settings page of the app.

# You.com API key — get $100 free credits at https://you.com/platform
# Used for competitor Discovery (Research API), pricing Fetching (Contents API),
# review sentiment, and deep market intelligence (Finance Research API).
YOUCOM_API_KEY=

# xAI (Grok) API key — https://console.x.ai
# Used to extract structured competitors and analyze pricing/feature/value diffs.
XAI_API_KEY=

# Grok model used for analysis (default shown). OpenAI-compatible endpoint.
XAI_MODEL=grok-4

# Override the xAI base URL if needed (defaults to the public endpoint).
XAI_BASE_URL=https://api.x.ai/v1

# ---- Insforge (backend database + auth) ----
# Your Insforge project URL and anon key — get these from your Insforge dashboard.
INSFORGE_BASE_URL=
INSFORGE_ANON_KEY=
# InsForge API key (ik_…) — required for first-party Google/GitHub OAuth bridging.
# INSFORGE_API_KEY=
# Browser-safe copies used by the Next.js authentication client. These values
# are public by design; database policies must still enforce access controls.
NEXT_PUBLIC_INSFORGE_BASE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Signs the anonymous visitor cookie used by the public feature-request board.
# Generate at least 32 random bytes, for example: openssl rand -hex 32
FEATURE_REQUEST_SIGNING_SECRET=

# First-party Google/GitHub OAuth (used by the Next.js client routes).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# OAUTH_STATE_SECRET=

# Public report links expire automatically after this many days (1–365).
SHARED_REPORT_TTL_DAYS=30

# ---- Web Push notifications (VAPID) ----
# Generate a keypair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Weekly digest email (Resend) ----
# API key from https://resend.com (free tier ~3k emails/mo). Leave blank to
# disable digest emails — the toggle/UI still work, emails are just skipped.
RESEND_API_KEY=
# Sender address on a domain verified in Resend (Domains → joinmira.ai).
DIGEST_FROM_EMAIL=Mira <noreply@joinmira.ai>
# In-app Help & feedback form delivery (comma-separated ok).
SUPPORT_TO_EMAIL=sam@joinmira.ai
# Optional extra inbox(es) for support copies.
SUPPORT_NOTIFY_EMAIL=

# Public URL of the frontend — used for links inside digest emails
# (set to your deployed Vercel/Render URL in production).
APP_URL=http://localhost:3000

# Server port (the Next.js client proxies /api to this in dev).
PORT=4000

# Set to "false" to disable the 24h scheduled auto-refresh.
AUTO_REFRESH_ENABLED=true

# ---- Apify (web traffic / company data scraping) ----
# API token from https://console.apify.com/settings/integrations — leave blank to disable traffic data.
APIFY_TOKEN=
# Web traffic uses SimilarWeb's JSON endpoint routed through Apify's RESIDENTIAL proxy.
# Residential proxies require a PAID Apify plan (the free tier returns 403). Once on a paid plan it works automatically.
# Optional: override the proxy group name if your plan differs ('' = datacenter, which SimilarWeb will block).
# APIFY_PROXY_GROUP=RESIDENTIAL
# Optional: pin the proxy exit country (e.g. US).
# APIFY_PROXY_COUNTRY=US
# Optional: an Apify Crunchbase-type actor id for the fact-check's structured funding spot-check.
# APIFY_CRUNCHBASE_ACTOR=

# ---- Tavily (independent fact-check search) ----
# Free key from https://tavily.com — verifies the market model's claims via a pipeline
# independent of You.com. If unset, the fact-check falls back to You.com (labeled as such).
TAVILY_API_KEY=
